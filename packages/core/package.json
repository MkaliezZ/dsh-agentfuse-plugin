{
  "name": "@dhms-agentfuse/core",
  "description": "Framework-agnostic AgentFuse policy engine: deterministic fail-closed tool-call authorization with evidence",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MkaliezZ/dsh-agentfuse-plugin.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": ">=5.6 <7",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepublishOnly": "npm run build"
  }
}
